DISCORD_TOKEN=

# Required. The id of the one server this bot serves. The bot leaves every other server.
GUILD_ID=

# Optional. The bot reads these once, on the first start, to seed the channel settings.
# After that, config.json wins. Use /set-channel to change them.
MOD_CHANNEL_ID=
BOT_LOG_CHANNEL_ID=
BAN_LOG_CHANNEL_ID=

# Optional. The file that holds the settings and the watched image hashes.
# Point it at a mounted volume in production.
CONFIG_PATH=config.json
